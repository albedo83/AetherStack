{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AetherStack",
  "version": "0.1.0",
  "identifier": "io.github.albedo83.aetherstack",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AetherStack",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "shortDescription": "Deterministic astrophotography preprocessing",
    "longDescription": "AetherStack calibrates, reviews, registers, normalizes, integrates, and drizzles astronomical FITS data with deterministic Rust algorithms and inspectable evidence.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
